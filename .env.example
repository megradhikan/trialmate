# LLM provider: mock | anthropic | openai | ollama
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb

# Scoring weights (hybrid mode)
SCORING_W_RULE=0.6
SCORING_W_SEM=0.3
SCORING_W_TRIAL=0.1
